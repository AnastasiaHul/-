<Window x:Class="Smart_tripp.WPF.TrainBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Trip — бронювання поїзда"
        Width="1120"
        Height="850"
        MinWidth="960"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526173"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BookingButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SeatItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background" Value="#EAF5F0"/>
            <Setter Property="Foreground" Value="#176B4B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SeatBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#C9E3D5"
                                BorderThickness="1">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SeatBorder"
                                        Property="Background"
                                        Value="#176B4B"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SeatBorder"
                                        Property="BorderBrush"
                                        Value="#176B4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Подорож починається з квитка"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#183B36"/>
                <TextBlock Text="Знайдіть рейс і виберіть зручне місце."
                           Margin="0,6,0,0"
                           Foreground="#526173"/>
            </StackPanel>

            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Content="← Назад"
                    Style="{StaticResource BookingButton}"/>
        </Grid>

        <TextBlock x:Name="BookingStatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="#526173"
                   TextWrapping="Wrap"
                   Text="Виберіть напрямок і дату."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FFF4D6"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock
                        Text="Навчальне бронювання. Рейси та ціни демонстраційні. Оплата не проводиться, справжній квиток не оформлюється."
                        TextWrapping="Wrap"
                        Foreground="#795B19"/>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1. Знайдіть рейс"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Звідки"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="DepartureCityBox"
                                          IsEditable="True"
                                          MinHeight="36">
                                    <ComboBoxItem Content="Львів"/>
                                    <ComboBoxItem Content="Київ"/>
                                    <ComboBoxItem Content="Одеса"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Куди"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ArrivalCityBox"
                                          IsEditable="True"
                                          MinHeight="36">
                                    <ComboBoxItem Content="Київ"/>
                                    <ComboBoxItem Content="Львів"/>
                                    <ComboBoxItem Content="Одеса"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Дата відправлення"
                                           Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="DepartureDatePicker"
                                            MinHeight="36"/>
                            </StackPanel>

                            <Button x:Name="SearchTrainsButton"
                                    Grid.Column="3"
                                    Content="Знайти рейси"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource BookingButton}"/>
                        </Grid>

                        <DataGrid x:Name="DeparturesGrid"
                                  Margin="0,18,0,0"
                                  Height="180"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Поїзд"
                                                    Binding="{Binding TrainNumber}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Звідки"
                                                    Binding="{Binding DepartureCity}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Куди"
                                                    Binding="{Binding ArrivalCity}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Відправлення"
                                                    Binding="{Binding DepartureAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                    Width="160"/>
                                <DataGridTextColumn Header="Прибуття"
                                                    Binding="{Binding ArrivalAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                    Width="160"/>
                                <DataGridTextColumn Header="Ціна, ₴"
                                                    Binding="{Binding TicketPrice, StringFormat=N2}"
                                                    Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="2. Виберіть місце"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="SelectedTrainText"
                                   Text="Спочатку виберіть рейс у таблиці."
                                   Foreground="#526173"
                                   Margin="0,8,0,14"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Вагон"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox x:Name="WagonBox"
                                      Width="100"
                                      MinHeight="36"/>
                        </StackPanel>

                        <TextBlock Text="Показані лише вільні місця. Натисніть на номер."
                                   Margin="0,14,0,8"
                                   Foreground="#526173"/>

                        <ListBox x:Name="SeatsList"
                                 MinHeight="60"
                                 MaxHeight="220"
                                 SelectionMode="Single"
                                 ItemContainerStyle="{StaticResource SeatItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="3. Підтвердіть бронювання"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Ваша подорож"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="BookingTripBox"
                                          DisplayMemberPath="Title"
                                          MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ім’я та прізвище пасажира"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PassengerNameBox"
                                         MaxLength="200"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="ReserveTrainButton"
                                Content="Забронювати вибране місце"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Style="{StaticResource BookingButton}"/>

                        <TextBlock x:Name="BookingConfirmationText"
                                   Margin="0,14,0,0"
                                   Foreground="#176B4B"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Бронювання вибраної подорожі"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <DataGrid x:Name="ReservationsGrid"
                                  Height="180"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код бронювання"
                                                    Binding="{Binding BookingCode}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Пасажир"
                                                    Binding="{Binding PassengerName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Вагон"
                                                    Binding="{Binding WagonNumber}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Місце"
                                                    Binding="{Binding SeatNumber}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Вартість, ₴"
                                                    Binding="{Binding TotalPrice, StringFormat=N2}"
                                                    Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>