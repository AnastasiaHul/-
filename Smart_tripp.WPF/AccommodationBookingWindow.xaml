<Window x:Class="Smart_tripp.WPF.AccommodationBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Trip — бронювання житла"
        Width="1120"
        Height="850"
        MinWidth="960"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">

    <Window.Resources>
        <Style x:Key="HousingCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="HousingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526173"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HousingButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Знайдіть місце для відпочинку"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#183B36"/>

                <TextBlock Text="Оберіть житло для своєї подорожі."
                           Margin="0,6,0,0"
                           Foreground="#526173"/>
            </StackPanel>

            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Content="← Назад"
                    Style="{StaticResource HousingButton}"/>
        </Grid>

        <TextBlock x:Name="HousingStatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="#526173"
                   TextWrapping="Wrap"
                   Text="Вкажіть місто та дати проживання."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FFF4D6"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock
                        Text="Навчальні пропозиції житла. Бронювання зберігається лише у Smart Trip, без оплати та звернення до власника."
                        TextWrapping="Wrap"
                        Foreground="#795B19"/>
                </Border>

                <Border Style="{StaticResource HousingCard}">
                    <StackPanel>
                        <TextBlock Text="1. Знайдіть вільне житло"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Місто"
                                           Style="{StaticResource HousingLabel}"/>

                                <ComboBox x:Name="HousingCityBox"
                                          IsEditable="True"
                                          MinHeight="36">
                                    <ComboBoxItem Content="Київ"/>
                                    <ComboBoxItem Content="Львів"/>
                                    <ComboBoxItem Content="Одеса"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Заїзд"
                                           Style="{StaticResource HousingLabel}"/>

                                <DatePicker x:Name="CheckInPicker"
                                            MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Виїзд"
                                           Style="{StaticResource HousingLabel}"/>

                                <DatePicker x:Name="CheckOutPicker"
                                            MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Гостей"
                                           Style="{StaticResource HousingLabel}"/>

                                <TextBox x:Name="GuestsCountBox"
                                         Text="1"
                                         MaxLength="2"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="SearchHousingButton"
                                    Grid.Column="4"
                                    Content="Знайти житло"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource HousingButton}"/>
                        </Grid>

                        <DataGrid x:Name="AccommodationsGrid"
                                  Height="200"
                                  Margin="0,18,0,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Житло"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Місто"
                                                    Binding="{Binding City}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Адреса"
                                                    Binding="{Binding Address}"
                                                    Width="240"/>

                                <DataGridTextColumn Header="До гостей"
                                                    Binding="{Binding MaxGuests}"
                                                    Width="85"/>

                                <DataGridTextColumn Header="За ніч, ₴"
                                                    Binding="{Binding PricePerNight, StringFormat=N2}"
                                                    Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HousingCard}">
                    <StackPanel>
                        <TextBlock Text="2. Перегляньте вибране житло"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="SelectedHousingText"
                                   Text="Виберіть пропозицію в таблиці."
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#183B36"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="HousingDescriptionText"
                                   Margin="0,10,0,0"
                                   Foreground="#526173"
                                   TextWrapping="Wrap"/>

                        <Border Background="#EAF5F0"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,16,0,0">
                            <TextBlock x:Name="StaySummaryText"
                                       Text="Тут з’явиться розрахунок вартості."
                                       Foreground="#176B4B"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HousingCard}">
                    <StackPanel>
                        <TextBlock Text="3. Забронюйте проживання"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Ваша подорож"
                                           Style="{StaticResource HousingLabel}"/>

                                <ComboBox x:Name="HousingTripBox"
                                          DisplayMemberPath="Title"
                                          MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ім’я та прізвище гостя"
                                           Style="{StaticResource HousingLabel}"/>

                                <TextBox x:Name="GuestNameBox"
                                         MaxLength="200"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="Заїзд і виїзд мають входити в дати вибраної подорожі. Вартість вказана за все житло."
                            Foreground="#526173"
                            Margin="0,14,0,0"
                            TextWrapping="Wrap"/>

                        <Button x:Name="ReserveHousingButton"
                                Content="Забронювати житло"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Style="{StaticResource HousingButton}"/>

                        <TextBlock x:Name="HousingConfirmationText"
                                   Margin="0,14,0,0"
                                   Foreground="#176B4B"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HousingCard}">
                    <StackPanel>
                        <TextBlock Text="Проживання у вибраній подорожі"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <DataGrid x:Name="HousingReservationsGrid"
                                  Height="180"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код бронювання"
                                                    Binding="{Binding BookingCode}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Гість"
                                                    Binding="{Binding GuestName}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="Заїзд"
                                                    Binding="{Binding CheckIn, StringFormat=dd.MM.yyyy}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Виїзд"
                                                    Binding="{Binding CheckOut, StringFormat=dd.MM.yyyy}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Гостей"
                                                    Binding="{Binding GuestsCount}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Разом, ₴"
                                                    Binding="{Binding TotalPrice, StringFormat=N2}"
                                                    Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>