<Window x:Class="Smart_tripp.WPF.PlaceWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Місце — Smart Trip"
        Width="1040"
        Height="800"
        MinWidth="880"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">

    <Window.Resources>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#466269"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#E5EDEF"
                                CornerRadius="8"
                                Padding="20,12"
                                Margin="0,0,8,14">
                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#167D6E"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="#E1E8EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок місця -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="SMART TRIP / КАТАЛОГ МІСЦЬ"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#167D6E"/>

                <TextBlock Text="{Binding Name}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#143A3D"
                           Margin="0,8,0,12"/>

                <WrapPanel>
                    <Border Background="#E3F2EC"
                            CornerRadius="6"
                            Padding="10,5"
                            Margin="0,0,16,0">
                        <TextBlock Text="{Binding Category}"
                                   Foreground="#167D6E"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#143A3D">
                        <Run Text="{Binding Price, StringFormat=N2}"/>
                        <Run Text=" ₴"/>
                    </TextBlock>

                    <TextBlock Text="за одне відвідування"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top">
                <Button x:Name="BackButton"
                        Content="← До каталогу"
                        Style="{StaticResource SecondaryButton}"/>

                <Button x:Name="FavoriteButton"
                        Content="♡ Зберегти в обране"
                        Style="{StaticResource SecondaryButton}"
                        Margin="3,10,3,3"/>
            </StackPanel>
        </Grid>

        <!-- Вкладки місця -->
        <TabControl x:Name="PlaceTabs"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- Огляд -->
            <TabItem Header="Огляд">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource PlaceCard}"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Про це місце"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14"/>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="15"
                                           LineHeight="25"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlaceCard}">
                            <StackPanel>
                                <TextBlock Text="Корисна інформація"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="АДРЕСА"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Address}"
                                           FontSize="16"
                                           Margin="0,8,0,24"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="ГРАФІК РОБОТИ"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Schedule}"
                                           FontSize="16"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Відгуки -->
            <TabItem Header="Відгуки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource PlaceCard}"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="AverageRatingText"
                                           Text="—"
                                           FontSize="38"
                                           FontWeight="Bold"
                                           Foreground="#167D6E"
                                           VerticalAlignment="Center"
                                           Margin="0,0,24,0"/>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Середня оцінка"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="ReviewCountText"
                                               Text="Відгуків ще немає"
                                               Foreground="#64748B"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource PlaceCard}"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Враження відвідувачів"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <DataGrid x:Name="PlaceReviewsGrid"
                                          Height="230"
                                          Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Header="Дата"
                                            Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                            Width="120"/>

                                        <DataGridTextColumn
                                            Header="Оцінка / 5"
                                            Binding="{Binding Rating}"
                                            Width="110"/>

                                        <DataGridTextColumn
                                            Header="Відгук"
                                            Binding="{Binding Comment}"
                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ReviewsAccessHint"
                                   Text="Увійдіть як турист, щоб залишити відгук."
                                   Foreground="#64748B"
                                   Margin="4,0,4,16"
                                   Visibility="Collapsed"/>

                        <Border Style="{StaticResource PlaceCard}">
                            <Expander x:Name="ReviewEditorExpander"
                                      Header="Написати відгук">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Ваша оцінка"/>

                                    <ComboBox x:Name="ReviewRatingBox"
                                              SelectedIndex="4"
                                              Width="150"
                                              HorizontalAlignment="Left">
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5"/>
                                    </ComboBox>

                                    <TextBlock Text="Поділіться враженнями"
                                               Margin="0,14,0,0"/>

                                    <TextBox x:Name="ReviewCommentBox"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Height="110"
                                             MaxLength="2000"/>

                                    <Button x:Name="SaveReviewButton"
                                            Content="Опублікувати відгук"
                                            HorizontalAlignment="Left"
                                            Margin="3,14,0,0"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Дії для подорожі -->
            <TabItem Header="Для моєї подорожі">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Додайте місце до своєї поїздки"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="4,8,0,8"/>

                        <TextBlock
                            Text="Оберіть дію — подорож і дату ви вкажете на наступному кроці."
                            Foreground="#64748B"
                            Margin="4,0,4,24"/>

                        <Border x:Name="TravelAccessHint"
                                Style="{StaticResource PlaceCard}"
                                Margin="0,0,0,16"
                                Background="#EAF2EF">
                            <StackPanel>
                                <TextBlock
                                    Text="Планування та додавання витрат доступні туристам."
                                    FontSize="16"/>

                                <Button x:Name="SignInButton"
                                        Content="Увійти"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid x:Name="TouristActionsPanel"
                                     Columns="2"
                                     Visibility="Collapsed">

                            <Border Style="{StaticResource PlaceCard}"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Запланувати відвідування"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Виберіть подорож, день і час. Місце з’явиться у вашому розкладі."
                                        Foreground="#64748B"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,24"/>

                                    <Button x:Name="PlanVisitButton"
                                            Content="Додати до плану"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PlaceCard}">
                                <StackPanel>
                                    <TextBlock Text="Врахувати в бюджеті"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Додайте вартість одного відвідування до витрат вибраної подорожі."
                                        Foreground="#64748B"
                                        TextWrapping="Wrap"
                                        Margin="0,0,0,24"/>

                                    <Button x:Name="AddPlaceExpenseButton"
                                            Content="Додати до витрат"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="PlaceStatusText"
                   Grid.Row="2"
                   Text="Дізнайтеся більше про місце або додайте його до своєї подорожі."
                   Foreground="#64748B"
                   Margin="4,16,0,0"/>
    </Grid>
</Window>