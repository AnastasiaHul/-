<Window x:Class="Smart_tripp.WPF.CarBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Trip — оренда автомобіля"
        Width="1120"
        Height="850"
        MinWidth="960"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">

    <Window.Resources>
        <Style x:Key="CarCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526173"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CarButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Свобода пересування"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#183B36"/>

                <TextBlock Text="Оберіть автомобіль для своєї подорожі."
                           Margin="0,6,0,0"
                           Foreground="#526173"/>
            </StackPanel>

            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Content="← Назад"
                    Style="{StaticResource CarButton}"/>
        </Grid>

        <TextBlock x:Name="CarStatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="#526173"
                   TextWrapping="Wrap"
                   Text="Вкажіть місто та дати оренди."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FFF4D6"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock
                        Text="Навчальна оренда: автомобілі та ціни демонстраційні. Бронювання зберігається лише у Smart Trip, без оплати."
                        TextWrapping="Wrap"
                        Foreground="#795B19"/>
                </Border>

                <Border Style="{StaticResource CarCard}">
                    <StackPanel>
                        <TextBlock Text="1. Знайдіть автомобіль"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Місто отримання"
                                           Style="{StaticResource CarLabel}"/>

                                <ComboBox x:Name="RentalCityBox"
                                          IsEditable="True"
                                          MinHeight="36">
                                    <ComboBoxItem Content="Київ"/>
                                    <ComboBoxItem Content="Львів"/>
                                    <ComboBoxItem Content="Одеса"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Отримання"
                                           Style="{StaticResource CarLabel}"/>

                                <DatePicker x:Name="PickupDatePicker"
                                            MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Повернення"
                                           Style="{StaticResource CarLabel}"/>

                                <DatePicker x:Name="ReturnDatePicker"
                                            MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Місць від"
                                           Style="{StaticResource CarLabel}"/>

                                <TextBox x:Name="RequiredSeatsBox"
                                         Text="1"
                                         MaxLength="2"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="SearchCarsButton"
                                    Grid.Column="4"
                                    Content="Знайти авто"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource CarButton}"/>
                        </Grid>

                        <DataGrid x:Name="CarsGrid"
                                  Height="200"
                                  Margin="0,18,0,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Марка"
                                                    Binding="{Binding Brand}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Модель"
                                                    Binding="{Binding Model}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Місто"
                                                    Binding="{Binding City}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Коробка передач"
                                                    Binding="{Binding Transmission}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="Місць"
                                                    Binding="{Binding SeatsCount}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="За день, ₴"
                                                    Binding="{Binding PricePerDay, StringFormat=N2}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CarCard}">
                    <StackPanel>
                        <TextBlock Text="2. Перегляньте вибране авто"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="SelectedCarText"
                                   Text="Виберіть автомобіль у таблиці."
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#183B36"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="CarDetailsText"
                                   Margin="0,10,0,0"
                                   Foreground="#526173"
                                   TextWrapping="Wrap"/>

                        <Border Background="#EAF5F0"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,16,0,0">
                            <TextBlock x:Name="RentalSummaryText"
                                       Text="Тут з’явиться розрахунок вартості."
                                       Foreground="#176B4B"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CarCard}">
                    <StackPanel>
                        <TextBlock Text="3. Оформіть оренду"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Ваша подорож"
                                           Style="{StaticResource CarLabel}"/>

                                <ComboBox x:Name="RentalTripBox"
                                          DisplayMemberPath="Title"
                                          MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,16,0">
                                <TextBlock Text="Ім’я та прізвище водія"
                                           Style="{StaticResource CarLabel}"/>

                                <TextBox x:Name="DriverNameBox"
                                         MaxLength="200"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Вік водія"
                                           Style="{StaticResource CarLabel}"/>

                                <TextBox x:Name="DriverAgeBox"
                                         MaxLength="3"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="У цій програмі мінімальний вік водія — 21 рік. Дати оренди мають входити в дати подорожі. Отримання та повернення — за тією самою адресою."
                            Foreground="#526173"
                            Margin="0,14,0,0"
                            TextWrapping="Wrap"/>

                        <Button x:Name="ReserveCarButton"
                                Content="Забронювати автомобіль"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Style="{StaticResource CarButton}"/>

                        <TextBlock x:Name="CarConfirmationText"
                                   Margin="0,14,0,0"
                                   Foreground="#176B4B"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CarCard}">
                    <StackPanel>
                        <TextBlock Text="Оренда у вибраній подорожі"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <DataGrid x:Name="CarReservationsGrid"
                                  Height="180"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код бронювання"
                                                    Binding="{Binding BookingCode}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Водій"
                                                    Binding="{Binding DriverName}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="Отримання"
                                                    Binding="{Binding PickupDate, StringFormat=dd.MM.yyyy}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Повернення"
                                                    Binding="{Binding ReturnDate, StringFormat=dd.MM.yyyy}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Разом, ₴"
                                                    Binding="{Binding TotalPrice, StringFormat=N2}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>