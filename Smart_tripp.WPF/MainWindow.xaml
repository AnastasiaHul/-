<Window x:Class="Smart_tripp.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Trip — відкривайте світ"
        Width="1280"
        Height="860"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#122F35">
            <DockPanel Margin="20,30,20,22">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SMART TRIP"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="24"/>

                    <TextBlock Text="ВАША НАСТУПНА ПОДОРОЖ"
                               Foreground="#86B8AF"
                               FontSize="10"
                               Margin="0,8,0,34"/>

                    <Button Content="⌂  Головна"
                            Tag="Home"
                            Click="OnNavigate"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="⌕  Каталог місць"
                            Tag="Catalog"
                            Click="OnNavigate"
                            Style="{StaticResource NavButton}"/>

                    <Button x:Name="TripsNav"
                            Content="▣  Мої подорожі"
                            Tag="Trips"
                            Click="OnNavigate"
                            IsEnabled="False"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="▤  Бронювання"
                            Click="OnOpenTrainBooking"
                            Style="{StaticResource NavButton}"/>

                    <Button x:Name="PlacesNav"
                            Content="◇  Місця партнера"
                            Tag="Places"
                            Click="OnNavigate"
                            IsEnabled="False"
                            Style="{StaticResource NavButton}"/>

                    <Button x:Name="BudgetNav"
                            Content="₴  Бюджет та речі"
                            Tag="Budget"
                            Click="OnNavigate"
                            IsEnabled="False"
                            Style="{StaticResource NavButton}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="#315158"
                            BorderThickness="0,1,0,0"
                            Padding="0,20,0,0">
                        <TextBlock
                            Text="Плануйте легко.&#10;Подорожуйте із задоволенням."
                            Foreground="#A9C4C5"
                            FontSize="13"
                            LineHeight="22"/>
                    </Border>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top"
                    Background="White"
                    BorderBrush="#E1E8EB"
                    BorderThickness="0,0,0,1"
                    Padding="24,16">
                <DockPanel>
                    <Button Content="← Назад"
                            Click="OnBack"
                            DockPanel.Dock="Left"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,18,0"/>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button x:Name="LoginNav"
                                Content="Увійти"
                                Tag="Login"
                                Click="OnOpenDialog"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button x:Name="RegisterNav"
                                Content="Реєстрація"
                                Tag="Register"
                                Click="OnOpenDialog"/>

                        <Button x:Name="LogoutButton"
                                Content="Вийти"
                                Tag="Logout"
                                Click="OnAuthAction"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   Text="Головна"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="SessionText"
                                   Text="Вітаємо у Smart Trip"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="White"
                    Padding="26,12"
                    BorderBrush="#E1E8EB"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText"
                           Text="Виберіть напрямок або увійдіть, щоб спланувати подорож."
                           Foreground="#64748B"
                           FontSize="12"/>
            </Border>

            <TabControl x:Name="Tabs"
                        SelectedIndex="4"
                        Background="Transparent"
                        BorderThickness="0">

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <TabItem x:Name="TripsTab"
                         Header="Мої подорожі"
                         IsEnabled="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="Мої подорожі"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#143A3D"
                                       Margin="4,0,0,8"/>

                            <TextBlock
                                Text="Оберіть поїздку — її план, карта, витрати та речі відкриються в окремому вікні."
                                Foreground="#64748B"
                                Margin="4,0,0,20"/>

                            <WrapPanel Margin="0,0,0,16">
                                <Button Content="＋ Створити подорож"
                                        Tag="NewTrip"
                                        Click="OnOpenDialog"/>

                                <Button Content="Відкрити подорож →"
                                        Click="OnOpenTripWorkspace"
                                        Style="{StaticResource SecondaryButton}"/>
                            </WrapPanel>

                            <DataGrid x:Name="TripsGrid"
                                      SelectionChanged="OnTripSelected"
                                      Height="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Назва"
                                                        Binding="{Binding Title}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Місто"
                                                        Binding="{Binding City}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Початок"
                                                        Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}"
                                                        Width="110"/>
                                    <DataGridTextColumn Header="Кінець"
                                                        Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}"
                                                        Width="110"/>
                                    <DataGridTextColumn Header="Бюджет ₴"
                                                        Binding="{Binding Budget, StringFormat=N2}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Людей"
                                                        Binding="{Binding PeopleCount}"
                                                        Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock
                                Text="Виберіть подорож і натисніть «Відкрити подорож», щоб переглянути план, витрати та речі."
                                Foreground="#64748B"
                                Margin="4,12"/>

                            <StackPanel x:Name="TripEditor"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                <TextBlock Text="Назва" Margin="5,2"/>
                                <TextBox x:Name="TripTitle"/>

                                <TextBlock Text="Місто" Margin="5,2"/>
                                <TextBox x:Name="TripCity"/>

                                <TextBlock Text="Початок" Margin="5,2"/>
                                <DatePicker x:Name="TripStart"/>

                                <TextBlock Text="Кінець" Margin="5,2"/>
                                <DatePicker x:Name="TripEnd"/>

                                <TextBlock Text="Бюджет ₴" Margin="5,2"/>
                                <TextBox x:Name="TripBudget"/>

                                <TextBlock Text="Кількість людей" Margin="5,2"/>
                                <TextBox x:Name="TripPeople"/>

                                <TextBlock Text="Інтереси" Margin="5,2"/>
                                <TextBox x:Name="TripInterests"/>

                                <Button Content="Зберегти подорож"
                                        Tag="Save"
                                        Click="OnTripAction"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="PlacesTab"
                         Header="Місця партнера"
                         IsEnabled="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="Ваші місця — додавання та керування"
                                       FontSize="18"
                                       Margin="4,0,0,8"/>

                            <WrapPanel Margin="0,0,0,16">
                                <Button Content="＋ Додати місце"
                                        Tag="NewPlace"
                                        Click="OnOpenDialog"/>

                                <Button Content="Редагувати вибране"
                                        Tag="EditPlace"
                                        Click="OnOpenDialog"/>

                                <Button Content="Видалити"
                                        Tag="Delete"
                                        Click="OnPlaceAction"/>

                                <Button Content="Оновити"
                                        Tag="Refresh"
                                        Click="OnPlaceAction"/>
                            </WrapPanel>

                            <DataGrid x:Name="PlacesGrid"
                                      SelectionChanged="OnPlaceSelected"
                                      Height="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Назва"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Категорія"
                                                        Binding="{Binding Category}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Ціна ₴"
                                                        Binding="{Binding Price, StringFormat=N2}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Адреса"
                                                        Binding="{Binding Address}"
                                                        Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock
                                Text="Виберіть місце в таблиці, щоб редагувати його або видалити."
                                Foreground="#64748B"
                                Margin="4,12"/>

                            <StackPanel x:Name="PlaceEditor"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                <TextBlock Text="Назва" Margin="5,2"/>
                                <TextBox x:Name="PlaceName"/>

                                <TextBlock Text="Категорія" Margin="5,2"/>
                                <TextBox x:Name="PlaceCategory"/>

                                <TextBlock Text="Ціна ₴" Margin="5,2"/>
                                <TextBox x:Name="PlacePrice"/>

                                <TextBlock Text="Адреса" Margin="5,2"/>
                                <TextBox x:Name="PlaceAddress"/>

                                <TextBlock Text="Графік роботи" Margin="5,2"/>
                                <TextBox x:Name="PlaceSchedule"/>

                                <TextBlock Text="Опис" Margin="5,2"/>
                                <TextBox x:Name="PlaceDescription"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"
                                         VerticalScrollBarVisibility="Auto"/>

                                <Button Content="Зберегти місце"
                                        Tag="Save"
                                        Click="OnPlaceAction"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Каталог місць">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <TextBlock Text="Каталог місць"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#143A3D"
                                       Margin="4,0,0,8"/>

                            <TextBlock
                                Text="Знайдіть цікаве місце та відкрийте його картку: опис, відгуки й дії для подорожі — всередині."
                                Foreground="#64748B"
                                Margin="4,0,0,20"/>

                            <Border Background="White"
                                    CornerRadius="12"
                                    BorderBrush="#E1E8EB"
                                    BorderThickness="1"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <WrapPanel>
                                    <StackPanel Width="220">
                                        <TextBlock Text="Назва місця"
                                                   Margin="5,2"/>
                                        <TextBox x:Name="SearchText"/>
                                    </StackPanel>

                                    <StackPanel Width="160">
                                        <TextBlock Text="Категорія"
                                                   Margin="5,2"/>
                                        <TextBox x:Name="SearchCategory"/>
                                    </StackPanel>

                                    <StackPanel Width="150">
                                        <TextBlock Text="Ціна до, ₴"
                                                   Margin="5,2"/>
                                        <TextBox x:Name="SearchPrice"/>
                                    </StackPanel>

                                    <CheckBox x:Name="OnlyFavorites"
                                              Content="Лише обране"
                                              VerticalAlignment="Bottom"
                                              Margin="12,0,12,16"/>

                                    <Button Content="Знайти"
                                            Tag="Search"
                                            Click="OnCatalogAction"
                                            VerticalAlignment="Bottom"
                                            Margin="3,0,3,5"/>
                                </WrapPanel>
                            </Border>

                            <DataGrid x:Name="CatalogGrid"
                                      Height="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Назва"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Категорія"
                                                        Binding="{Binding Category}"
                                                        Width="170"/>
                                    <DataGridTextColumn Header="Ціна ₴"
                                                        Binding="{Binding Price, StringFormat=N2}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Адреса"
                                                        Binding="{Binding Address}"
                                                        Width="240"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="Відкрити місце →"
                                    Click="OnOpenPlaceWorkspace"
                                    HorizontalAlignment="Left"
                                    Margin="3,12,0,0"/>

                            <TextBlock
                                Text="Виберіть місце в таблиці та відкрийте його картку."
                                Foreground="#64748B"
                                Margin="4,12"/>

                            <StackPanel x:Name="ReviewEditor"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                <TextBlock
                                    Text="Залишити відгук про вибране місце"
                                    FontWeight="Bold"
                                    Margin="5,12,0,4"/>

                                <TextBlock Text="Оцінка" Margin="5,2"/>

                                <ComboBox x:Name="RatingBox"
                                          SelectedIndex="4">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                </ComboBox>

                                <TextBlock Text="Відгук" Margin="5,2"/>
                                <TextBox x:Name="ReviewComment"/>

                                <Button Content="Зберегти відгук"
                                        Tag="Review"
                                        Click="OnCatalogAction"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="BudgetTab"
                         Header="Бюджет та речі"
                         IsEnabled="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <WrapPanel>
                                <TextBlock Text="Подорож:"
                                           VerticalAlignment="Center"/>

                                <ComboBox x:Name="BudgetTrip"
                                          Width="400"
                                          DisplayMemberPath="Title"
                                          SelectionChanged="OnBudgetTripChanged"/>

                                <Button Content="Розрахувати бюджет"
                                        Tag="Calculate"
                                        Click="OnBudgetAction"/>

                                <Button Content="Статистика витрат"
                                        Tag="Statistics"
                                        Click="OnOpenDialog"/>
                            </WrapPanel>

                            <TextBlock x:Name="BudgetSummaryText"
                                       Text="Виберіть подорож"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="5,10"/>

                            <TextBlock Text="Витрати"
                                       FontSize="18"
                                       Margin="4,8"/>

                            <DataGrid x:Name="ExpensesGrid" Height="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата"
                                                        Binding="{Binding Date, StringFormat=dd.MM.yyyy}"
                                                        Width="110"/>
                                    <DataGridTextColumn Header="Категорія"
                                                        Binding="{Binding Category}"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="Опис"
                                                        Binding="{Binding Description}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Сума ₴"
                                                        Binding="{Binding Amount, StringFormat=N2}"
                                                        Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="＋ Додати витрату"
                                    Tag="Expense"
                                    Click="OnOpenDialog"/>

                            <TextBlock Text="Список речей"
                                       FontSize="18"
                                       Margin="4,12,0,5"/>

                            <DataGrid x:Name="PackingGrid" Height="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Річ"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                    <DataGridCheckBoxColumn Header="Спаковано"
                                                            Binding="{Binding IsPacked}"
                                                            Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel>
                                <StackPanel Width="300">
                                    <TextBlock Text="Назва речі" Margin="5,2"/>
                                    <TextBox x:Name="PackingName"/>
                                </StackPanel>

                                <Button Content="Додати річ"
                                        Tag="Add"
                                        Click="OnPackingAction"/>

                                <Button Content="Зібрано / не зібрано"
                                        Tag="Toggle"
                                        Click="OnPackingAction"/>

                                <Button Content="Видалити річ"
                                        Tag="Delete"
                                        Click="OnPackingAction"/>
                            </WrapPanel>

                            <StackPanel x:Name="ExpenseEditor"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                <TextBlock Text="Категорія" Margin="5,2"/>
                                <TextBox x:Name="ExpenseCategory"/>

                                <TextBlock Text="Опис витрати" Margin="5,2"/>
                                <TextBox x:Name="ExpenseDescription"/>

                                <TextBlock Text="Сума ₴" Margin="5,2"/>
                                <TextBox x:Name="ExpenseAmount"/>

                                <TextBlock Text="Дата витрати" Margin="5,2"/>
                                <DatePicker x:Name="ExpenseDate"/>

                                <Button Content="Додати витрату"
                                        Tag="Expense"
                                        Click="OnBudgetAction"/>
                            </StackPanel>

                            <StackPanel x:Name="StatisticsEditor"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                <TextBlock Text="Статистика за категоріями"
                                           Margin="5,10,0,4"
                                           FontWeight="Bold"/>

                                <DataGrid x:Name="StatisticsGrid"
                                          Height="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Категорія"
                                                            Binding="{Binding Category}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Витрачено ₴"
                                                            Binding="{Binding Total, StringFormat=N2}"
                                                            Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28">
                            <Border Background="#E3EEEA"
                                    CornerRadius="18"
                                    Padding="32"
                                    MinHeight="260">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ВІДКРИВАЙТЕ УКРАЇНУ"
                                                   Foreground="#26776B"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>

                                        <TextBlock
                                            Text="Ваша подорож.&#10;Ваші враження."
                                            FontSize="38"
                                            FontWeight="Bold"
                                            Foreground="#143A3D"
                                            Margin="0,12,0,14"/>

                                        <TextBlock
                                            Text="Знаходьте цікаві місця, плануйте бюджет&#10;і збирайтеся в дорогу зі Smart Trip."
                                            Foreground="#4D6969"
                                            FontSize="15"
                                            LineHeight="24"/>

                                        <WrapPanel Margin="0,20,0,0">
                                            <Button Content="Спланувати подорож →"
                                                    Tag="NewTrip"
                                                    Click="OnOpenDialog"/>

                                            <Button Content="Переглянути місця"
                                                    Tag="Catalog"
                                                    Click="OnNavigate"
                                                    Style="{StaticResource SecondaryButton}"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Viewbox Grid.Column="1" Margin="18">
                                        <Canvas Width="300" Height="240">
                                            <Ellipse Width="70"
                                                     Height="70"
                                                     Fill="#E8BB72"
                                                     Canvas.Left="198"
                                                     Canvas.Top="12"/>

                                            <Path Fill="#B6CEC1"
                                                  Data="M0,210 L95,58 200,210Z"/>

                                            <Path Fill="#719D8C"
                                                  Data="M75,210 L192,42 300,210Z"/>

                                            <Path Fill="#3B7066"
                                                  Data="M145,210 L238,100 310,210Z"/>

                                            <Path Fill="#F1F5EF"
                                                  Data="M158,91 L192,42 225,91 198,79 185,87 173,80Z"/>

                                            <Path Stroke="#F3D8AC"
                                                  StrokeThickness="12"
                                                  Data="M150,235 C90,178 230,177 179,132"/>

                                            <TextBlock Text="EXPLORE"
                                                       FontSize="12"
                                                       Foreground="#355E54"
                                                       Canvas.Left="10"
                                                       Canvas.Top="18"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <TextBlock Text="Куди вирушимо?"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,28,0,6"/>

                            <TextBlock
                                Text="Оберіть напрямок, щоб переглянути місця в каталозі."
                                Foreground="#64748B"
                                Margin="0,0,0,14"/>

                            <UniformGrid Columns="4">
                                <Button Content="ЛЬВІВ&#10;Архітектура й історія →"
                                        Tag="Львів"
                                        Click="OnDestination"
                                        Style="{StaticResource DestinationButton}"/>

                                <Button Content="КИЇВ&#10;Ритм великого міста →"
                                        Tag="Київ"
                                        Click="OnDestination"
                                        Style="{StaticResource DestinationButton}"/>

                                <Button Content="ОДЕСА&#10;Прогулянки біля моря →"
                                        Tag="Одеса"
                                        Click="OnDestination"
                                        Style="{StaticResource DestinationButton}"/>

                                <Button Content="КАРПАТИ&#10;Ближче до природи →"
                                        Tag="Карпати"
                                        Click="OnDestination"
                                        Style="{StaticResource DestinationButton}"/>
                            </UniformGrid>

                            <TextBlock Text="Усе для вашої подорожі"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,26,0,12"/>

                            <UniformGrid Columns="3">
                                <Button
                                    Content="01   Мої подорожі&#10;Плани, дати та інтереси →"
                                    Tag="Trips"
                                    Click="OnNavigate"
                                    Style="{StaticResource DestinationButton}"/>

                                <Button
                                    Content="02   Бюджет&#10;Витрати під контролем →"
                                    Tag="Budget"
                                    Click="OnNavigate"
                                    Style="{StaticResource DestinationButton}"/>

                                <Button
                                    Content="03   Обране&#10;Збережені місця →"
                                    Tag="Favorites"
                                    Click="OnNavigate"
                                    Style="{StaticResource DestinationButton}"/>
                            </UniformGrid>

                            <StackPanel x:Name="DialogStore"
                                        Visibility="Collapsed">
                                <StackPanel x:Name="LoginPanel">
                                    <TextBlock
                                        Text="Раді бачити вас у Smart Trip"
                                        Foreground="#64748B"
                                        Margin="4,0,0,18"/>

                                    <TextBlock Text="Email"/>
                                    <TextBox x:Name="EmailBox"/>

                                    <TextBlock Text="Пароль"
                                               Margin="0,12,0,0"/>
                                    <PasswordBox x:Name="PasswordBox"/>

                                    <StackPanel x:Name="RegistrationFields">
                                        <TextBlock Text="Ім’я"
                                                   Margin="0,12,0,0"/>
                                        <TextBox x:Name="NameBox"/>

                                        <TextBlock Text="Роль"
                                                   Margin="0,12,0,0"/>

                                        <ComboBox x:Name="RoleBox"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Турист"
                                                          Tag="Tourist"/>
                                            <ComboBoxItem Content="Партнер"
                                                          Tag="Partner"/>
                                        </ComboBox>

                                        <TextBlock
                                            Text="Пароль має містити щонайменше 10 символів."
                                            Foreground="#64748B"
                                            FontSize="12"
                                            Margin="4,10"/>
                                    </StackPanel>

                                    <Button x:Name="LoginSubmit"
                                            Content="Увійти →"
                                            Tag="Login"
