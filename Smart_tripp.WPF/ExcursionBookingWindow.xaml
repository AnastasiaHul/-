<Window x:Class="Smart_tripp.WPF.ExcursionBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Trip — бронювання екскурсії"
        Width="1120"
        Height="850"
        MinWidth="960"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F3F6F8">

    <Window.Resources>
        <Style x:Key="ExcursionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="ExcursionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526173"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ExcursionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Відкрийте місто по-новому"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#183B36"/>

                <TextBlock Text="Знайдіть екскурсію та забронюйте місця для своєї компанії."
                           Margin="0,6,0,0"
                           Foreground="#526173"/>
            </StackPanel>

            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Content="← Назад"
                    Style="{StaticResource ExcursionButton}"/>
        </Grid>

        <TextBlock x:Name="ExcursionStatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="#526173"
                   TextWrapping="Wrap"
                   Text="Оберіть місто, дату та кількість учасників."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#FFF4D6"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock
                        Text="Навчальні екскурсії з демонстраційними цінами й розкладом. Бронювання зберігається лише у Smart Trip, без оплати."
                        TextWrapping="Wrap"
                        Foreground="#795B19"/>
                </Border>

                <Border Style="{StaticResource ExcursionCard}">
                    <StackPanel>
                        <TextBlock Text="1. Знайдіть екскурсію"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Місто"
                                           Style="{StaticResource ExcursionLabel}"/>

                                <ComboBox x:Name="ExcursionCityBox"
                                          IsEditable="True"
                                          MinHeight="36">
                                    <ComboBoxItem Content="Київ"/>
                                    <ComboBoxItem Content="Львів"/>
                                    <ComboBoxItem Content="Одеса"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Дата екскурсії"
                                           Style="{StaticResource ExcursionLabel}"/>

                                <DatePicker x:Name="ExcursionDatePicker"
                                            MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,12,0">
                                <TextBlock Text="Учасників"
                                           Style="{StaticResource ExcursionLabel}"/>

                                <TextBox x:Name="ParticipantsBox"
                                         Text="1"
                                         MaxLength="4"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="SearchExcursionsButton"
                                    Grid.Column="3"
                                    Content="Знайти екскурсії"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource ExcursionButton}"/>
                        </Grid>

                        <DataGrid x:Name="OffersGrid"
                                  Height="200"
                                  Margin="0,18,0,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Екскурсія"
                                                    Binding="{Binding Session.Title}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Початок"
                                                    Binding="{Binding Session.StartsAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                    Width="160"/>

                                <DataGridTextColumn Header="Тривалість, хв"
                                                    Binding="{Binding Session.DurationMinutes}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Вільних місць"
                                                    Binding="{Binding AvailableSeats}"
                                                    Width="115"/>

                                <DataGridTextColumn Header="За особу, ₴"
                                                    Binding="{Binding Session.PricePerPerson, StringFormat=N2}"
                                                    Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ExcursionCard}">
                    <StackPanel>
                        <TextBlock Text="2. Перегляньте програму"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="SelectedExcursionText"
                                   Text="Виберіть екскурсію в таблиці."
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#183B36"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="ExcursionDetailsText"
                                   Margin="0,10,0,0"
                                   Foreground="#526173"
                                   TextWrapping="Wrap"/>

                        <Border Background="#EAF5F0"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0,16,0,0">
                            <TextBlock x:Name="ExcursionSummaryText"
                                       Text="Тут з’явиться розрахунок вартості."
                                       Foreground="#176B4B"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ExcursionCard}">
                    <StackPanel>
                        <TextBlock Text="3. Забронюйте місця"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Ваша подорож"
                                           Style="{StaticResource ExcursionLabel}"/>

                                <ComboBox x:Name="ExcursionTripBox"
                                          DisplayMemberPath="Title"
                                          MinHeight="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ім’я та прізвище відповідального гостя"
                                           Style="{StaticResource ExcursionLabel}"/>

                                <TextBox x:Name="GuestNameBox"
                                         MaxLength="200"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="Екскурсія має проходити в межах дат вибраної подорожі. Перед збереженням програма повторно перевірить вільні місця."
                            Foreground="#526173"
                            Margin="0,14,0,0"
                            TextWrapping="Wrap"/>

                        <Button x:Name="ReserveExcursionButton"
                                Content="Забронювати місця"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Style="{StaticResource ExcursionButton}"/>

                        <TextBlock x:Name="ExcursionConfirmationText"
                                   Margin="0,14,0,0"
                                   Foreground="#176B4B"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ExcursionCard}">
                    <StackPanel>
                        <TextBlock Text="Екскурсії у вибраній подорожі"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <DataGrid x:Name="ExcursionReservationsGrid"
                                  Height="180"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код бронювання"
                                                    Binding="{Binding BookingCode}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Відповідальний гість"
                                                    Binding="{Binding GuestName}"
                                                    Width="200"/>

                                <DataGridTextColumn Header="Учасників"
                                                    Binding="{Binding ParticipantsCount}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Разом, ₴"
                                                    Binding="{Binding TotalPrice, StringFormat=N2}"
                                                    Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>