<UserControl x:Class="Smart_tripp.WPF.Views.PackingTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="14">
        <TextBlock Text="Додайте готовий набір речей. Дублікати пропускаються."/>

        <TextBlock Text="Шаблон" Margin="0,8,0,4"/>
        <ComboBox ItemsSource="{Binding Templates}"
                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                  DisplayMemberPath="Name"/>

        <TextBlock Text="У шаблоні:" Margin="3,8,3,4"/>
        <ItemsControl ItemsSource="{Binding SelectedTemplate.Items}" Margin="12,0"/>

        <Button Content="Додати речі з шаблону"
                HorizontalAlignment="Left"
                Command="{Binding ApplyCommand}"/>

        <TextBlock Text="Уже у списку подорожі:" Margin="3,8,3,4"/>
        <ItemsControl ItemsSource="{Binding CurrentItems}" Margin="12,0"/>

        <TextBlock Text="{Binding Status}"
                   FontWeight="SemiBold"
                   Margin="3,8"/>
    </StackPanel>
</UserControl>
