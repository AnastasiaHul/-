<UserControl x:Class="Smart_tripp.WPF.Views.RescheduleVisitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="14">
        <TextBlock Text="Виберіть відвідування та вкажіть новий час або примітку."/>

        <DataGrid Height="230"
                  ItemsSource="{Binding Visits}"
                  SelectedItem="{Binding SelectedVisit, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата і час" Binding="{Binding VisitAt, StringFormat=dd.MM.yyyy HH:mm}" Width="155"/>
                <DataGridTextColumn Header="Місце" Binding="{Binding PlaceName}" Width="*"/>
                <DataGridTextColumn Header="Примітка" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Нова дата" Margin="0,8,0,4"/>
        <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}"
                    DisplayDateStart="{Binding TripStart, Mode=OneWay}"
                    DisplayDateEnd="{Binding TripEnd, Mode=OneWay}"/>

        <TextBlock Text="Новий час (ГГ:ХХ)" Margin="0,8,0,4"/>
        <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Примітка" Margin="0,8,0,4"/>
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Content="Перенести відвідування"
                HorizontalAlignment="Left"
                Command="{Binding RescheduleCommand}"/>

        <TextBlock Text="{Binding Status}"
                   FontWeight="SemiBold"
                   Margin="3,8"/>
    </StackPanel>
</UserControl>
