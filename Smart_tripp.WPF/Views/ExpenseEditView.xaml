<UserControl x:Class="Smart_tripp.WPF.Views.ExpenseEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="14">
        <TextBlock Text="Виберіть витрату, щоб змінити або видалити її."/>

        <DataGrid Height="230"
                  ItemsSource="{Binding Expenses}"
                  SelectedItem="{Binding SelectedExpense, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="105"/>
                <DataGridTextColumn Header="Категорія" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="Опис" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Сума ₴" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Категорія" Margin="0,8,0,4"/>
        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Опис" Margin="0,8,0,4"/>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Сума ₴" Margin="0,8,0,4"/>
        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Дата" Margin="0,8,0,4"/>
        <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}"
                    DisplayDateStart="{Binding TripStart, Mode=OneWay}"
                    DisplayDateEnd="{Binding TripEnd, Mode=OneWay}"/>

        <WrapPanel>
            <Button Content="Зберегти зміни" Command="{Binding SaveCommand}"/>
            <Button Content="Видалити витрату" Command="{Binding DeleteCommand}"/>
        </WrapPanel>

        <TextBlock Text="{Binding Status}"
                   FontWeight="SemiBold"
                   Margin="3,8"/>
    </StackPanel>
</UserControl>
