<UserControl x:Class="Smart_tripp.WPF.Views.TripCopyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="14">
        <TextBlock Text="Створює нову подорож із тими самими параметрами, планом і списком речей. Дати плану зсуваються. Витрати та бронювання не копіюються."/>

        <TextBlock Text="Назва нової подорожі" Margin="0,8,0,4"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Нова дата початку" Margin="0,8,0,4"/>
        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                    DisplayDateStart="{Binding MinimumDate, Mode=OneWay}"/>

        <Button Content="Створити копію"
                HorizontalAlignment="Left"
                Command="{Binding CopyCommand}"/>

        <TextBlock Text="{Binding Status}"
                   FontWeight="SemiBold"
                   Margin="3,8"/>
    </StackPanel>
</UserControl>
